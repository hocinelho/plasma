# Plasma environment variables — copy this file to .env and edit locally
# NEVER commit .env, only this .example file

# --- Local LLM (Ollama) ---
# OLLAMA_MODEL must be a TEXT model you've pulled — check with: ollama list
# mistral:latest (quality) | llama3.2:3b or qwen2.5:3b (≈2x faster) | orca-mini (fastest)
#
# Best local pick if you have the RAM: qwen3:30b-a3b
#   A mixture-of-experts model — 30B parameters in total, but only ~3B of them
#   run per token. You get close to 30B quality at roughly 3B speed, which is
#   exactly the trade a voice assistant wants. ~18 GB on disk, and it needs
#   about 24 GB of RAM (or a GPU with 24 GB VRAM to be genuinely quick).
#     ollama pull qwen3:30b-a3b
# Smaller rungs of the same family: qwen3:14b, qwen3:8b, qwen3:4b.
#
# Avoid "reasoning" models here (deepseek-r1 and friends). They think in long
# visible monologues before answering, which is the opposite of what you want
# when the answer has to be spoken out loud.
#
# A wrong/unpulled name returns 404; Plasma warns at startup and asks you to pull it.
# Point this at ANOTHER PC to run a bigger/faster model there — no code change.
# See docs/distributed-setup.md (set OLLAMA_HOST=0.0.0.0 on that machine).
#   OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# --- Logging ---
PLASMA_LOG_LEVEL=INFO

# --- Cloud LLM (provider-agnostic OpenAI-compatible, optional) ---
# Leave CLOUD_API_KEY blank to stay fully local (Ollama only).
#
# Provider options (all speak the OpenAI wire protocol):
#
#   Google Gemini — free tier, 1500 req/day
#     CLOUD_API_KEY=your_google_ai_studio_key_here
#     CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     CLOUD_MODEL=gemini-2.0-flash
#
#   OpenRouter + Kimi K2.6 — free tier, 200 req/day, 20 req/min
#     Strong multilingual (German + English), 262K context.
#     NOTE: the kimi-k2.6:free endpoint can be pulled by OpenRouter (paid only);
#     if you get a 404 "unavailable for free", use the auto-router below instead.
#     CLOUD_API_KEY=sk-or-your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=moonshotai/kimi-k2.6:free
#
#   OpenRouter + GLM (Zhipu) — paid, and the fastest of the strong ones.
#     GLM-4.6 is the frontier model; glm-4.5-air is markedly cheaper and
#     quicker, which for a voice assistant is usually the better trade — you
#     feel the reply arriving more than you feel the last 5% of quality.
#     CLOUD_API_KEY=sk-or-your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=z-ai/glm-4.6          # or z-ai/glm-4.5-air
#
#   OpenRouter auto-router — free, 50 req/day (1000 with $10 credit)
#     Picks whatever free model is currently available, so it never 404s when
#     one model goes offline. Quality/latency varies per request.
#     CLOUD_API_KEY=sk-or-your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=openrouter/free
#
#   Cerebras — free tier, 60K tok/min
#     CLOUD_API_KEY=your_cerebras_key_here
#     CLOUD_BASE_URL=https://api.cerebras.ai/v1
#     CLOUD_MODEL=llama-3.3-70b
#
#   OpenRouter — free models available
#     CLOUD_API_KEY=your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
#   Groq — was free, now paid
#     CLOUD_API_KEY=your_groq_key_here
#     CLOUD_BASE_URL=https://api.groq.com/openai/v1
#     CLOUD_MODEL=llama-3.1-8b-instant
#
#   Claude (Anthropic) — native Messages API, NOT OpenAI-wire-compatible.
#     Set CLOUD_PROVIDER=anthropic so cloud_client uses Claude's own request/
#     response shape instead of /chat/completions. CLOUD_BASE_URL is unused
#     in this mode (the Anthropic endpoint is fixed in code).
#     CLOUD_PROVIDER=anthropic
#     CLOUD_API_KEY=sk-ant-your_anthropic_key_here
#     CLOUD_MODEL=claude-haiku-4-5
#
CLOUD_PROVIDER=openai
CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_MODEL=gemini-2.0-flash

# --- Whisper model (speed vs accuracy tradeoff) ---
# English-only models (faster, .en suffix):
# WHISPER_MODEL=tiny.en    # ~1s, less accurate
# WHISPER_MODEL=base.en    # ~2s, good balance
# WHISPER_MODEL=small.en   # ~3-5s, default (English only)
# WHISPER_MODEL=medium.en  # ~8s, best for accents (English only)
#
# Multilingual models (required for German / non-English speech):
# WHISPER_MODEL=small      # ~3-5s, supports all languages including German
# WHISPER_MODEL=medium     # ~8s, best multilingual accuracy
#
# --- Language detection (S9: German + English) ---
# WHISPER_LANGUAGE=en      # force English (default, fastest)
# WHISPER_LANGUAGE=de      # force German
# WHISPER_LANGUAGE=auto    # detect language automatically — requires a multilingual model above
#
# With auto, detection is clamped to these languages so short, accented
# phrases aren't mis-heard as Arabic/Turkish/etc. (only languages you speak):
# WHISPER_ALLOWED_LANGS=en,de
#
# --- German TTS voice (Piper) ---
# Required only when WHISPER_LANGUAGE=de or auto.
# 1. Download the voice model once:
#      python scripts/download_de_voice.py
# 2. Set the path below:
# TTS_VOICE_DE=voices/de_DE-thorsten-medium.onnx
# FEMALE VOICE: the avatar is a woman, so a female voice usually fits better.
#   python scripts/download_female_voice.py --list     # see the options
#   python scripts/download_female_voice.py            # gets en_US-amy-medium
# then set:  TTS_VOICE_MODEL=voices/en_US-amy-medium.onnx

# --- Wake word (PA-34 / PA-89, optional) ---
# Set WAKE_WORD_ENABLED=true to enable hands-free detection.
# Requires openwakeword (already in requirements.txt).
# The mic is shared with the browser — both can listen simultaneously on Windows.
# WAKE_WORD_ENABLED=false

# Option A — pre-trained "Hey Jarvis" (works out of the box):
# WAKE_WORD_MODEL=hey_jarvis
# WAKE_WORD_THRESHOLD=0.3         # 0.1=very sensitive, 0.5=very strict

# Option B — custom "Hey Plasma" model (PA-89):
#   1. python scripts/train_hey_plasma.py
#   2. Set path below:
# WAKE_WORD_MODEL_PATH=.plasma/models/hey_plasma.onnx
# WAKE_WORD_THRESHOLD=0.5

# --- Networking / TLS ---------------------------------------------------------
# Outbound HTTPS (Wikipedia, translation, weather) uses the OS certificate
# store via truststore, so corporate MITM proxies work out of the box.
# If you still hit CERTIFICATE_VERIFY_FAILED on a trusted local network, you
# can disable verification as a last resort:
# PLASMA_INSECURE_SSL=false

# --- Speaker identification (PA-65, S11) ---------------------------------------
# Voice profiles: say "remember my voice as <name>" once, then Plasma greets
# you personally and keeps per-user facts (USER_<Name>.md).
# Requires:  pip install resemblyzer   (optional — pulls in torch, ~200MB)
# SPEAKER_ID_ENABLED=true
# SPEAKER_THRESHOLD=0.70    # 0.5 = loose match, 0.9 = strict

# --- Google Calendar + Gmail (alternative to Microsoft Graph) ------------------
# 1. Create a project at https://console.cloud.google.com
#    - Enable: Google Calendar API, Gmail API
#    - Create OAuth 2.0 credentials (Desktop app)
# 2. Copy the Client ID and Secret below
# 3. Run once: python scripts/google_auth.py
#    Token saved to .plasma/google_token.json (gitignored, never committed)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# --- Microsoft Graph (Outlook calendar + email) --------------------------------
# 1. Register an app at https://portal.azure.com → App registrations
#    - Supported accounts: Personal Microsoft accounts (or your org's tenant)
#    - Authentication → Allow public client flows: Yes
#    - API permissions → Microsoft Graph → Delegated:
#        Calendars.Read, Calendars.ReadWrite, Mail.Read
# 2. Copy the Application (client) ID below
# 3. Run once: python scripts/ms_auth.py
#    Token saved to .plasma/ms_token.json (gitignored, never committed)
# MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MS_TENANT_ID=common   # "common" works for personal + work accounts

# --- Microsoft Teams meeting summary (PA-79, S13) ------------------------------
# Reuses the Microsoft Graph app above (MS_CLIENT_ID/MS_TENANT_ID) and the
# Calendars.Read scope already granted — no new app registration needed.
# Teams meetings are detected as calendar events with isOnlineMeeting=true.

# --- Slack (PA-78, S13) ---------------------------------------------------------
# 1. Create a Slack app at https://api.slack.com/apps -> From scratch
# 2. OAuth & Permissions -> User Token Scopes: channels:read, channels:history, users:read
# 3. Install the app to your workspace
# 4. Copy the User OAuth Token (starts with xoxp-) below
# SLACK_USER_TOKEN=xoxp-your-user-token-here

# --- WhatsApp via Twilio (PA-80, S13) -------------------------------------------
# 1. Sign up at https://www.twilio.com
# 2. Console -> Account SID + Auth Token
# 3. Messaging -> Try it out -> Send a WhatsApp message (sandbox), or connect
#    a production WhatsApp Business number
# 4. Copy the values below. TWILIO_WHATSAPP_FROM is your Twilio WhatsApp number
#    in E.164 format (no "whatsapp:" prefix — Plasma adds it automatically).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=+14155238886
#
# To message someone by name ("send whatsapp to John: ..."), save their
# number first by voice: "remember that John's number is +491701234567"

# --- Clap-to-wake (double-clap detection, optional) ---------------------------
# Two quick claps trigger the same wake event as "Hey Jarvis" / wake word.
# Pure numpy, no ML model, zero extra dependencies.
# CLAP_WAKE_ENABLED=false
# CLAP_THRESHOLD=12.0    # peak must be this many × background RMS to count
# CLAP_WINDOW_MS=600     # max milliseconds between the two claps
# CLAP_MIN_CREST=5.0     # impulsiveness gate — stops loud talking from
#                        # triggering it. If real claps stop being detected in
#                        # a very echoey/carpeted room, lower this to 3.5-4.
# CLAP_MIN_PEAK=1400     # absolute loudness floor (0-32767); raise this if
#                        # clicks near the mic still false-trigger

# --- Camera / vision (optional, requires mediapipe + opencv-python) -----------
# pip install mediapipe opencv-python
# MediaPipe EfficientDet model (~4.4 MB) is downloaded automatically to
# .plasma/models/ on first use. Apache 2.0 license — no AGPL.
#
# Voice commands:
#   "What do you see?"        → snapshot from local camera → spoken description
#   "Watch for a person"      → background monitor, fires spoken alert when spotted
#   "Stop watching"           → stop the background monitor
#
# POST /vision/snapshot  accepts {"image_b64": "<jpeg>"} from browser/phone camera.
# WS   /ws/vision-input  streams frames from getUserMedia on any browser/phone.
#
# CAMERA_ENABLED=false
# CAMERA_DEVICE=0          # OpenCV device index (0 = default webcam)
# VISION_SCORE_THRESHOLD=0.5  # min confidence to report an object (0–1)
# CAMERA_SETTLE_S=1.2      # let the webcam run this long before the first shot so
#                          # auto white-balance/exposure converge (fixes colour cast)
# CAMERA_AUTO_WHITE_BALANCE=false  # extra software colour fix; on only if a cast remains

# --- LocateAnything open-vocabulary visual search (optional) -------------------
# Find ANY object by description ("find my keys") instead of the fixed 80
# MediaPipe classes. Powered by locate-anything.cpp (NVIDIA LocateAnything-3B).
# 1. git clone --recursive https://github.com/mudler/locate-anything.cpp
#    cmake -B build -DLA_BUILD_CLI=ON && cmake --build build -j
# 2. Download a GGUF model from huggingface.co/mudler/locate-anything.cpp-gguf
#    (recommended: locate-anything-q8_0.gguf, ~6.3 GB)
# 3. Point Plasma at the binary + model:
# Object search uses a 3-tier backend — highest available tier is used automatically:
#
# Tier 1 (instant, zero install) — cloud vision LLM
#   Uses CLOUD_API_KEY above. Gemini 2.0 Flash supports images free (1500 req/day).
#   No extra config needed — works as soon as CLOUD_API_KEY is set.
#
# Tier 2 (offline) — Ollama vision model. Set this ONCE (a duplicate line silently
#   overrides the first!). Also powers "what do you see / what am I wearing".
#   moondream (~1.7 GB) = fastest but hallucinates colours/detail.
#   llava (~4.7 GB) or llama3.2-vision (~7.8 GB) = far more accurate (real colours,
#   sees a watch). Recognition runs occasionally, so the bigger model is fine.
#   Run e.g.: ollama pull llama3.2-vision   then set:
# LOCATE_VISION_OLLAMA_MODEL=llama3.2-vision:latest
# LOCATE_VISION_OLLAMA_MODEL=moondream
#   If the chosen model errors (too big → Ollama 500) or blanks, Plasma auto-tries
#   these lighter models in order. Comma-separated; blank to disable.
# LOCATE_VISION_OLLAMA_FALLBACKS=llava,moondream
#
# Tier 3 (offline, heavy) — locate-anything.cpp CLI (6 GB GGUF, C++ build)
#   See external/locate-anything/README.md for build + download steps.
# LOCATE_ANYTHING_BIN=external\locate-anything.cpp\build\examples\cli\Release\locate-anything-cli.exe
# LOCATE_ANYTHING_MODEL=external\locate-anything.cpp\models\locate-anything-q8_0.gguf
# LOCATE_ANYTHING_MODE=hybrid
# LOCATE_ANYTHING_TIMEOUT=60
# LOCATE_ANYTHING_THREADS=20
#
# Tier 3 remote server variant:
# LOCATE_ANYTHING_SERVER_URL=http://192.168.1.50:8765

# --- Image generation via Muapi.ai (Open-Generative-AI backend, optional) ------
# "Generate an image of a sunset" → returns a hosted image URL.
# Get an access key at https://muapi.ai
# MUAPI_API_KEY=your_muapi_access_key_here
# MUAPI_BASE_URL=https://api.muapi.ai
# MUAPI_IMAGE_MODEL=flux-schnell    # model endpoint slug muapi exposes
# MUAPI_TIMEOUT=120                 # max seconds to poll for the result

# --- Home Assistant smart home integration (optional) --------------------------
# 1. Install Home Assistant: https://www.home-assistant.io/
#    (runs on a Raspberry Pi, VM, or Docker container on your LAN)
# 2. Profile → Long-Lived Access Tokens → CREATE TOKEN → copy below
# 3. Say: "turn on the lights", "turn off the bedroom lights", "dim the lights"
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token_here
# HA_LIGHT_ENTITY=light.all   # default entity when no room is specified


# --- WiFi presence sensing (RuView) — OPTIONAL ---
# RuView senses people from WiFi CSI (through-wall presence, room occupancy).
# Needs its own hardware (ESP32-S3 ~$9 / RPi+nexmon_csi) OR the no-hardware demo:
#   docker run -p 3000:3000 ruvnet/wifi-densepose:latest
# Plasma is the voice layer: "is anyone home?", "who's in the living room?".
# RUVIEW_ENABLED=true
# RUVIEW_URL=http://localhost:3000
# RUVIEW_API_KEY=
# Proactive spoken alerts on presence changes (someone enters / house empties):
# RUVIEW_ALERTS=true
# RUVIEW_POLL_S=5.0
# RUVIEW_ALERT_COOLDOWN_S=30.0

# --- Passive learning ---
# Notice durable facts in ordinary conversation and remember them, instead of
# only when told "remember that ...". Runs in the background after the reply,
# so it never slows the conversation. Near-duplicates are merged.
PASSIVE_LEARNING_ENABLED=true

# --- Speed knobs (see docs/performance.md) ---
# How long Ollama keeps the model in memory between questions. Ollama's own
# default is 5 minutes, so the first question after a break pays the whole
# model load again — tens of seconds on a 14B. "-1" keeps it loaded for good.
OLLAMA_KEEP_ALIVE=30m
# Cap on how much she can say. A spoken reply costs time twice: generating it
# and speaking it. ~160 tokens is a few comfortable sentences. 0 = no cap.
OLLAMA_NUM_PREDICT=160
# Context window. 0 = the model's own default. Raise only if long
# conversations start losing the thread; bigger costs memory and speed.
OLLAMA_NUM_CTX=0
