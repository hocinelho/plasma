# Plasma environment variables — copy this file to .env and edit locally
# NEVER commit .env, only this .example file

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# --- Logging ---
PLASMA_LOG_LEVEL=INFO

# --- Cloud LLM (provider-agnostic OpenAI-compatible, optional) ---
# Leave CLOUD_API_KEY blank to stay fully local (Ollama only).
#
# Provider options (all speak the OpenAI wire protocol):
#
#   Google Gemini — free tier, 1500 req/day
#     CLOUD_API_KEY=your_google_ai_studio_key_here
#     CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     CLOUD_MODEL=gemini-2.0-flash
#
#   OpenRouter + Kimi K2.6 — free tier, 200 req/day, 20 req/min
#     Strong multilingual (German + English), 262K context.
#     NOTE: the kimi-k2.6:free endpoint can be pulled by OpenRouter (paid only);
#     if you get a 404 "unavailable for free", use the auto-router below instead.
#     CLOUD_API_KEY=sk-or-your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=moonshotai/kimi-k2.6:free
#
#   OpenRouter auto-router — free, 50 req/day (1000 with $10 credit)
#     Picks whatever free model is currently available, so it never 404s when
#     one model goes offline. Quality/latency varies per request.
#     CLOUD_API_KEY=sk-or-your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=openrouter/free
#
#   Cerebras — free tier, 60K tok/min
#     CLOUD_API_KEY=your_cerebras_key_here
#     CLOUD_BASE_URL=https://api.cerebras.ai/v1
#     CLOUD_MODEL=llama-3.3-70b
#
#   OpenRouter — free models available
#     CLOUD_API_KEY=your_openrouter_key_here
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
#   Groq — was free, now paid
#     CLOUD_API_KEY=your_groq_key_here
#     CLOUD_BASE_URL=https://api.groq.com/openai/v1
#     CLOUD_MODEL=llama-3.1-8b-instant
#
#   Claude (Anthropic) — native Messages API, NOT OpenAI-wire-compatible.
#     Set CLOUD_PROVIDER=anthropic so cloud_client uses Claude's own request/
#     response shape instead of /chat/completions. CLOUD_BASE_URL is unused
#     in this mode (the Anthropic endpoint is fixed in code).
#     CLOUD_PROVIDER=anthropic
#     CLOUD_API_KEY=sk-ant-your_anthropic_key_here
#     CLOUD_MODEL=claude-haiku-4-5
#
CLOUD_PROVIDER=openai
CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_MODEL=gemini-2.0-flash

# --- Whisper model (speed vs accuracy tradeoff) ---
# English-only models (faster, .en suffix):
# WHISPER_MODEL=tiny.en    # ~1s, less accurate
# WHISPER_MODEL=base.en    # ~2s, good balance
# WHISPER_MODEL=small.en   # ~3-5s, default (English only)
# WHISPER_MODEL=medium.en  # ~8s, best for accents (English only)
#
# Multilingual models (required for German / non-English speech):
# WHISPER_MODEL=small      # ~3-5s, supports all languages including German
# WHISPER_MODEL=medium     # ~8s, best multilingual accuracy
#
# --- Language detection (PA-49: German + English + Arabic) ---
# WHISPER_LANGUAGE=en      # force English (default, fastest)
# WHISPER_LANGUAGE=de      # force German
# WHISPER_LANGUAGE=ar      # force Arabic
# WHISPER_LANGUAGE=auto    # detect language automatically — requires a multilingual model above
#
# With auto, detection is clamped to these languages so short, accented
# phrases aren't mis-heard as unexpected languages (only languages you speak):
# WHISPER_ALLOWED_LANGS=en,de
# WHISPER_ALLOWED_LANGS=en,de,ar   # add Arabic
#
# --- German TTS voice (Piper) ---
# Required only when WHISPER_LANGUAGE=de or auto.
# 1. Download the voice model once:
#      python scripts/download_de_voice.py
# 2. Set the path below:
# TTS_VOICE_DE=voices/de_DE-thorsten-medium.onnx
#
# --- Arabic TTS voice (Piper, PA-49) ---
# Required only when WHISPER_LANGUAGE=ar or auto with Arabic in WHISPER_ALLOWED_LANGS.
# 1. Download the voice model once:
#      python scripts/download_ar_voice.py
# 2. Set the path below:
# TTS_VOICE_AR=voices/ar_JO-kareem-medium.onnx

# --- Wake word (PA-34 / PA-89, optional) ---
# Set WAKE_WORD_ENABLED=true to enable hands-free detection.
# Requires openwakeword (already in requirements.txt).
# The mic is shared with the browser — both can listen simultaneously on Windows.
# WAKE_WORD_ENABLED=false

# Option A — pre-trained "Hey Jarvis" (works out of the box):
# WAKE_WORD_MODEL=hey_jarvis
# WAKE_WORD_THRESHOLD=0.3         # 0.1=very sensitive, 0.5=very strict

# Option B — custom "Hey Plasma" model (PA-89):
#   1. python scripts/train_hey_plasma.py
#   2. Set path below:
# WAKE_WORD_MODEL_PATH=.plasma/models/hey_plasma.onnx
# WAKE_WORD_THRESHOLD=0.5

# --- Networking / TLS ---------------------------------------------------------
# Outbound HTTPS (Wikipedia, translation, weather) uses the OS certificate
# store via truststore, so corporate MITM proxies work out of the box.
# If you still hit CERTIFICATE_VERIFY_FAILED on a trusted local network, you
# can disable verification as a last resort:
# PLASMA_INSECURE_SSL=false

# --- Speaker identification (PA-65, S11) ---------------------------------------
# Voice profiles: say "remember my voice as <name>" once, then Plasma greets
# you personally and keeps per-user facts (USER_<Name>.md).
# Requires:  pip install resemblyzer   (optional — pulls in torch, ~200MB)
# SPEAKER_ID_ENABLED=true
# SPEAKER_THRESHOLD=0.70    # 0.5 = loose match, 0.9 = strict

# --- Google Calendar + Gmail (alternative to Microsoft Graph) ------------------
# 1. Create a project at https://console.cloud.google.com
#    - Enable: Google Calendar API, Gmail API
#    - Create OAuth 2.0 credentials (Desktop app)
# 2. Copy the Client ID and Secret below
# 3. Run once: python scripts/google_auth.py
#    Token saved to .plasma/google_token.json (gitignored, never committed)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# --- Microsoft Graph (Outlook calendar + email) --------------------------------
# 1. Register an app at https://portal.azure.com → App registrations
#    - Supported accounts: Personal Microsoft accounts (or your org's tenant)
#    - Authentication → Allow public client flows: Yes
#    - API permissions → Microsoft Graph → Delegated:
#        Calendars.Read, Calendars.ReadWrite, Mail.Read
# 2. Copy the Application (client) ID below
# 3. Run once: python scripts/ms_auth.py
#    Token saved to .plasma/ms_token.json (gitignored, never committed)
# MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MS_TENANT_ID=common   # "common" works for personal + work accounts

# --- Microsoft Teams meeting summary (PA-79, S13) ------------------------------
# Reuses the Microsoft Graph app above (MS_CLIENT_ID/MS_TENANT_ID) and the
# Calendars.Read scope already granted — no new app registration needed.
# Teams meetings are detected as calendar events with isOnlineMeeting=true.

# --- Slack (PA-78, S13) ---------------------------------------------------------
# 1. Create a Slack app at https://api.slack.com/apps -> From scratch
# 2. OAuth & Permissions -> User Token Scopes: channels:read, channels:history, users:read
# 3. Install the app to your workspace
# 4. Copy the User OAuth Token (starts with xoxp-) below
# SLACK_USER_TOKEN=xoxp-your-user-token-here

# --- WhatsApp via Twilio (PA-80, S13) -------------------------------------------
# 1. Sign up at https://www.twilio.com
# 2. Console -> Account SID + Auth Token
# 3. Messaging -> Try it out -> Send a WhatsApp message (sandbox), or connect
#    a production WhatsApp Business number
# 4. Copy the values below. TWILIO_WHATSAPP_FROM is your Twilio WhatsApp number
#    in E.164 format (no "whatsapp:" prefix — Plasma adds it automatically).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=+14155238886
#
# To message someone by name ("send whatsapp to John: ..."), save their
# number first by voice: "remember that John's number is +491701234567"

