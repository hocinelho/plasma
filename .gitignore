@"
# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- PyCharm ---
.idea/
*.iml

# --- Environment & secrets ---
.env
.env.local
*.key
*.pem
tts_test.wav
*.wav
# --- Plasma private memory ---
# Private working notes stay local, never pushed to GitHub
.plasma/
!.plasma/skills/
.plasma/MEMORY.md
.plasma/USER.md
.plasma/memory.sqlite
.plasma/audit.log
.plasma/voices/
.plasma/USER.md
.plasma/skill_proposals.json
# scratch/one-shot scripts
_*.py
# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs & temp ---
*.log
*.tmp
tmp/

# --- PyInstaller (PA-46) ---
build/
dist/
*.spec.bak

# --- Claude Code local session state ---
.claude/

# --- External dependencies (binaries + large models, never commit) ---
external/locate-anything/bin/*.exe
external/locate-anything/bin/locate-anything-cli
external/locate-anything/models/*.gguf

voices/
external/locate-anything.cpp/

# Characters fetched by scripts/get_avatars.py.
#
# 62 MB of binaries under non-commercial sample licences, and this repo is
# public — so they are fetched onto your machine from the project that
# published them, under its own terms, rather than committed here.
# brunette.glb is already tracked and stays tracked: ignoring a file does not
# untrack it, and she has to have someone to be out of the box.
frontend/avatars/*.glb
!frontend/avatars/brunette.glb
